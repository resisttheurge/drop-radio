{
  "name": "@drop-radio/observable-child-process",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "scope:server"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "libs/server/observable-child-process/dist",
          "tsConfig": "libs/server/observable-child-process/tsconfig.lib.json",
          "packageJson": "libs/server/observable-child-process/package.json",
          "main": "libs/server/observable-child-process/src/index.ts",
          "stripLeadingPaths": true
        }
      }
    }
  },
  "dependencies": {
    "@swc/helpers": "^0.5.3",
    "rxjs": "^7.8.2"
  }
}
