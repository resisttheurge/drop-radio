{
  "name": "@drop-radio/ui",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/ui",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "nx": {
    "tags": [
      "scope:ui"
    ],
    "targets": {
      "build": {
        "options": {
          "platform": "web",
          "clear": false
        },
        "configurations": {
          "test": {}
        }
      },
      "start": {
        "executor": "@nx/expo:start",
        "dependsOn": [
          "@drop-radio/server:serve",
          "^build"
        ],
        "options": {
          "port": 8081,
          "clear": false
        }
      },
      "serve": {
        "dependsOn": [
          "@drop-radio/server:serve",
          "^build"
        ],
        "options": {
          "port": 8081,
          "clear": false
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build"
        ]
      },
      "docker:run": {
        "options": {
          "rm": "true",
          "publish": "8081:80"
        },
        "continuous": true,
        "dependsOn": [
          "docker:build",
          "@drop-radio/server:docker:run"
        ]
      }
    }
  },
  "dependencies": {
    "@drop-radio/core-components": "*",
    "@drop-radio/core-themes": "*",
    "@drop-radio/neumorphism": "*",
    "@drop-radio/playlist": "*",
    "@drop-radio/stream-player": "*",
    "@drop-radio/theme": "*",
    "@drop-radio/theme-context": "*",
    "@expo/metro-config": "*",
    "@react-navigation/native": "*",
    "@shopify/react-native-skia": "*",
    "enhanced-resolve": "*",
    "expo-asset": "*",
    "expo-audio": "*",
    "expo-constants": "*",
    "expo-image": "*",
    "expo-linking": "*",
    "expo-router": "*",
    "expo-splash-screen": "*",
    "expo-status-bar": "*",
    "expo-system-ui": "*",
    "expo": "*",
    "picocolors": "*",
    "react-native-css-animations": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-svg-transformer": "*",
    "react-native-svg": "*",
    "react-native-web": "*",
    "react-native-track-player": "*",
    "react-native-worklets": "*",
    "react-native": "*",
    "react": "*",
    "shaka-player": "*",
    "@reduxjs/toolkit": "*",
    "react-redux": "*",
    "chroma-js": "*",
    "tiny-invariant": "*",
    "expo-linear-gradient": "*",
    "@expo/vector-icons": "*",
    "expo-video": "*",
    "jsonc-eslint-parser": "*",
    "@swc/helpers": "*"
  },
  "devDependencies": {
    "@nx/detox": "*",
    "@nx/devkit": "*",
    "@nx/eslint-plugin": "*",
    "@nx/eslint": "*",
    "@nx/js": "*",
    "@nx/react": "*",
    "@nx/rollup": "*",
    "@testing-library/react-native": "*",
    "@types/jest": "*",
    "@types/node": "*",
    "jest-expo": "*",
    "metro-config": "*",
    "metro-resolver": "*",
    "semver": "*",
    "tsconfig-paths": "*",
    "tslib": "*"
  }
}
