{
  "name": "@drop-radio/ui",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "eas-build-post-install": "cd ../../ && node tools/scripts/eas-build-post-install.mjs . apps/ui",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "nx": {
    "tags": [
      "scope:ui"
    ],
    "implicitDependencies": [
      "@drop-radio/server"
    ],
    "targets": {
      "build": {
        "options": {
          "platform": "web",
          "clear": false
        },
        "configurations": {
          "test": {}
        }
      },
      "start": {
        "executor": "@nx/expo:start",
        "dependsOn": [
          "@drop-radio/server:serve",
          "^build"
        ],
        "options": {
          "port": 8080,
          "clear": false
        },
        "continuous": true
      },
      "serve": {
        "dependsOn": [
          "@drop-radio/server:serve",
          "^build"
        ],
        "options": {
          "port": 8080,
          "clear": false
        },
        "continuous": true
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build"
        ]
      },
      "docker:run": {
        "options": {
          "rm": "true",
          "publish": "8080:80"
        },
        "continuous": true,
        "dependsOn": [
          "docker:build",
          "@drop-radio/server:docker:run"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo-audio": "~56.0.13",
    "expo-router": "~56.2.22",
    "expo-splash-screen": "~56.0.16",
    "expo-video": "~56.1.4"
  },
  "devDependencies": {
    "jest-expo": "^56.0.0"
  }
}
