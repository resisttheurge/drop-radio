{
  "name": "@drop-radio/server",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "scope:server"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/server/dist",
          "format": [
            "cjs"
          ],
          "main": "apps/server/src/main.ts",
          "tsConfig": "apps/server/tsconfig.app.json",
          "assets": [
            "apps/server/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "bundle": true,
            "thirdParty": true,
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "buildTarget": "@drop-radio/server:build",
          "runBuildTargetDependencies": true,
          "watch": true
        },
        "configurations": {
          "development": {
            "buildTarget": "@drop-radio/server:build:development"
          },
          "production": {
            "buildTarget": "@drop-radio/server:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "docker:build": {
        "dependsOn": [
          "build"
        ]
      },
      "docker:volume": {
        "command": "{projectRoot}/copy-to-volume ${INPUT_DIRECTORY} drop-audio"
      },
      "docker:run": {
        "options": {
          "rm": true,
          "publish": "8080:80",
          "volume": "drop-audio:/app/input"
        },
        "continuous": true,
        "dependsOn": [
          "docker:volume",
          "docker:build"
        ]
      }
    }
  }
}
