{
  "name": "@drop-radio/source",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=20.20.0"
  },
  "packageManager": "bun@1.4.4",
  "devEngines": {
    "runtime": [
      {
        "name": "bun",
        "version": ">=1.4.4",
        "onFail": "download"
      },
      {
        "name": "node",
        "version": ">=26.8.1",
        "onFail": "warn"
      }
    ],
    "packageManager": [
      {
        "name": "bun",
        "version": ">=1.4.4",
        "onFail": "download"
      },
      {
        "name": "npm",
        "version": ">=11.9.0",
        "onFail": "warn"
      }
    ]
  },
  "scripts": {
    "sync-audio": "gcloud storage rsync gs://drop-audio assets/drop-audio --recursive --delete-unmatched-destination-objects --exclude=.gitkeep",
    "docs": "typedoc --options typedoc.config.mjs",
    "ci": "npx nx affected -t lint test build docs e2e -c=test"
  },
  "private": true,
  "nx": {
    "targets": {
      "docs": {
        "cache": true,
        "dependsOn": [
          {
            "projects": "*",
            "target": "build"
          }
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/assets/generated-docs"
        ]
      }
    }
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@google-cloud/pino-logging-gcp-config": "^1.0.6",
    "@js-temporal/polyfill": "^0.5.1",
    "axios": "^1.6.0",
    "fastify": "~5.8.2",
    "fastify-plugin": "~5.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.7",
    "rxjs": "^7.8.2",
    "tiny-invariant": "^1.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@fast-check/jest": "^2.1.1",
    "@nx/devkit": "24.0.6",
    "@nx/esbuild": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/node": "24.0.6",
    "@nx/playwright": "24.0.6",
    "@nx/react-native": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@nx/workspace": "24.0.6",
    "@playwright/test": "^1.65.1",
    "@react-native-community/cli": "18.0.1",
    "@react-native-community/cli-platform-android": "18.0.1",
    "@react-native-community/cli-platform-ios": "18.0.1",
    "@react-native/babel-preset": "0.79.7",
    "@react-native/metro-config": "0.79.7",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@swc/jest": "0.2.39",
    "@testing-library/react-native": "13.2.2",
    "@types/jest": "30.0.0",
    "@types/node": "^22.16.0",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/ui": "5.1.1",
    "babel-jest": "30.3.0",
    "esbuild": "^0.19.2",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-tsdoc": "^0.4.0",
    "fast-check": "^4.1.1",
    "jest": "30.3.0",
    "jest-environment-jsdom": "30.0.5",
    "jest-environment-node": "^29.7.0",
    "jest-util": "30.0.5",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "24.0.6",
    "pino-pretty": "^13.0.0",
    "prettier": "^2.6.2",
    "react-native-svg": "15.11.2",
    "react-native-svg-transformer": "1.5.3",
    "react-native-svg-web": "~1.0.9",
    "react-native-web": "0.20.0",
    "react-test-renderer": "^19.0.0",
    "ts-jest": "29.4.9",
    "ts-jest-mocker": "^1.3.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typedoc": "^0.28.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "workspaces": [
    "apps/*",
    "libs/server/*"
  ],
  "allowScripts": {
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "@swc/core@1.16.22": true,
    "@parcel/watcher@2.6.0": true,
    "nx@24.0.6": true,
    "protobufjs@7.2.5": true
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "nx",
    "protobufjs"
  ]
}
