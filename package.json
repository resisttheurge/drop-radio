{
  "name": "@drop-radio/source",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=20.20.0"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "^24.14.0",
        "onFail": "warn"
      }
    ],
    "packageManager": [
      {
        "name": "npm",
        "version": "^11.9.0",
        "onFail": "warn"
      }
    ]
  },
  "scripts": {
    "sync-audio": "gcloud storage rsync gs://drop-audio assets/drop-audio --recursive --delete-unmatched-destination-objects --exclude=.gitkeep",
    "deploy-ui": "gcloud storage rsync dist/apps/ui/web gs://drop-radio-ui --recursive --delete-unmatched-destination-objects --exclude=.gitkeep --cache-control=\"public, max-age=60\"",
    "docs": "typedoc --options typedoc.config.mjs"
  },
  "private": true,
  "nx": {
    "targets": {
      "docs": {
        "cache": true,
        "dependsOn": [
          {
            "projects": "*",
            "target": "build"
          }
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{workspaceRoot}/assets/generated-docs"
        ]
      }
    }
  },
  "dependencies": {
    "@expo/metro-config": "~54.0.9",
    "@expo/metro-runtime": "~6.1.2",
    "@fastify/cors": "^11.1.0",
